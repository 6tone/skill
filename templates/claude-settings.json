{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git add . *)",
      "Bash(git add -A *)",
      "Bash(git branch -D *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git add . *)",
      "PowerShell(git add -A *)",
      "PowerShell(git branch -D *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(!.env.example)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Edit(!.env.example)"
    ],
    "ask": [
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(npm install *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Bash(npm run build *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",
      "Bash(rm -rf *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(npm install *)",
      "PowerShell(npm uninstall *)",
      "PowerShell(npm update *)",
      "PowerShell(npm run build *)",
      "PowerShell(pnpm add *)",
      "PowerShell(pnpm remove *)",
      "PowerShell(pnpm update *)",
      "PowerShell(Remove-Item *)"
    ]
  }
}
